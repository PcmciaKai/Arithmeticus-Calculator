<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer on Android 12 (API 31) and newer. Everything the app stores
     (settings, history, variables) is plain local data that is safe to restore, so all of it
     is included in both. -->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
